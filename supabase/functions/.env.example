# Edge Function secrets — SERVER-ONLY. Every value here is secret.
# Local:      copy to supabase/functions/.env and run `pnpm functions:serve`
# Production: `supabase secrets set --env-file supabase/functions/.env --project-ref <ref>`
# Never put these in apps/web (NEXT_PUBLIC_*) or apps/mobile (EXPO_PUBLIC_*), and never commit .env.
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
# Supabase Edge Runtime (local and hosted) and must NOT be set here.

# HMAC-SHA256 key for kiosk QR tokens (decision D-08). 32+ random bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
QR_SIGNING_SECRET=replace-with-32-random-bytes-base64
# Previous key, accepted during rotation (D-11). Leave empty when not rotating.
QR_SIGNING_SECRET_PREVIOUS=

# HMAC-SHA256 key for employee personal (fallback) QR tokens (D-12). Must differ from QR_SIGNING_SECRET.
PERSONAL_QR_SIGNING_SECRET=replace-with-another-32-random-bytes-base64
PERSONAL_QR_SIGNING_SECRET_PREVIOUS=

# Pepper for hashing device installation IDs: device_id_hash = HMAC-SHA256(pepper, raw_id) (D-05).
# Changing it un-binds every phone, so rotate only together with a planned device reset.
DEVICE_HASH_PEPPER=replace-with-32-random-bytes-base64

# Shared secret for a future fingerprint terminal calling device-sync (FR-116). Empty disables the endpoint.
DEVICE_SYNC_API_KEY=

# Optional e-mail notifications through Resend (D-33). Empty = in-app notifications only.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="BHW Attendance <no-reply@example.com>"

# Public URL of the web portal, used in e-mail links.
APP_URL=http://localhost:3000

# Comma-separated origins allowed by CORS for browser calls (web portal + kiosk).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
