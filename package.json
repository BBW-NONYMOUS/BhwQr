{
  "name": "bhw-qr-attendance",
  "private": true,
  "version": "0.1.0",
  "description": "BHW QR Attendance System - Barangay Kalawag II Health Workers Office",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@bhw/web",
    "dev:mobile": "turbo run dev --filter=@bhw/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > packages/types/src/database.types.ts",
    "db:test": "supabase test db",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "db:test:remote": "node scripts/run-pgtap.mjs",
    "functions:test": "cd supabase/functions && npx -y deno@2 test --allow-env",
    "db:types:remote": "supabase gen types typescript --linked --schema public > packages/types/src/database.types.ts",
    "db:push": "supabase db push --linked",
    "smoke:remote": "node scripts/smoke-remote.mjs",
    "secrets:gen": "node scripts/gen-function-secrets.mjs",
    "smoke:functions": "node scripts/smoke-functions.mjs",
    "seed:photos": "node scripts/seed-demo-photos.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "supabase": "^2.122.0",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
