{
  "name": "@bhw/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of colors, radius and typography for web (Tailwind v4), mobile (NativeWind/Tailwind v3), React Native Paper and Tamagui.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./web.css": "./web.css",
    "./paper": "./src/paper.ts",
    "./tamagui": "./src/tamagui.ts"
  },
  "files": [
    "src",
    "tailwind-preset.cjs",
    "web.css",
    "scripts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "node --test --experimental-strip-types src/tokens.test.ts",
    "build": "node scripts/generate.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
