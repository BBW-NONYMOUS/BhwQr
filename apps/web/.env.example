# BHW QR Attendance System - web (apps/web)
# Copy to .env.local and fill in. `supabase start` prints the local values (or run `supabase status`).
# Never commit .env.local.

# ---------------------------------------------------------------------------
# PUBLIC - exposed to the browser (NEXT_PUBLIC_ prefix). Safe to ship to clients.
# ---------------------------------------------------------------------------

# Supabase API URL. Local dev default from `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon / publishable key ("anon key" or "Publishable key" in `supabase status`).
# Row Level Security is what protects data; this key is public by design.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-or-publishable-key

# Public origin of this web app (used for auth email redirects: <APP_URL>/auth/callback).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SERVER-ONLY - read only in server code (lib/env.server.ts, lib/supabase/admin.ts).
# NEVER prefix with NEXT_PUBLIC_ and never import from a client component.
# ---------------------------------------------------------------------------

# Supabase service role / secret key. Bypasses RLS - admin server actions only.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
