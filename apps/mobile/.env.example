# apps/mobile/.env.example -> copy to apps/mobile/.env (never commit .env)
#
# EXPO_PUBLIC_* values are INLINED INTO THE APP BUNDLE at build time. They are NOT secret:
# anyone can extract them from the APK/IPA. Only public values belong here.
# Never put SUPABASE_SERVICE_ROLE_KEY, the QR HMAC secret or any other server-only secret in this file.

# Supabase API URL.
# Local dev on a PHYSICAL phone: use the LAN IP of the dev PC running `supabase start`,
# e.g. http://192.168.1.10:54321 (find it with `ipconfig` on Windows). 127.0.0.1 / localhost
# would point at the phone itself. The Android emulator can use http://10.0.2.2:54321.
# Production: https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321

# Supabase anon (publishable) key. Public by design: Row Level Security protects the data.
# Local: printed by `supabase status` (anon key).
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key

# Optional. Web portal URL opened by "Register on the website" on the Login screen.
# Defaults to http://localhost:3000 (use the PC's LAN IP for a physical phone in development).
EXPO_PUBLIC_WEB_URL=http://localhost:3000
