{
  "name": "@bhw/types",
  "version": "0.1.0",
  "private": true,
  "description": "Generated Supabase database types, shared zod schemas, enums and the error-code catalog for web and mobile.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./database": "./src/database.types.ts"
  },
  "scripts": {
    "gen:errors": "node scripts/generate-errors.mjs",
